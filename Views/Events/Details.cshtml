@model NewFolder.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <h2 class="mb-4">📖 Event Details</h2>

    <div class="card shadow-sm">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height:300px; object-fit:cover;" />
        }
        <div class="card-body">
            <h3 class="card-title">@Model.Title</h3>
            <p class="card-text">@Model.Description</p>
            <p><strong>Date:</strong> @Model.Date.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
