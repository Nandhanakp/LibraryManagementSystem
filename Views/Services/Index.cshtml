@model IEnumerable<NewFolder.Models.Service>

@{
    ViewData["Title"] = "Library Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center py-5" style="background: linear-gradient(90deg, #6a85b6, #bac8e0); color: #222;">
    <div class="container">
        <h2 class="fw-bold"><span class="fs-3">📖</span> Our Services</h2>
    </div>
</div>

<div class="container my-5">

    <!-- Add Service Button (Staff Only) -->
    @if (Context.Session.GetString("Role") == "Staff")
    {
        <div class="d-flex justify-content-end mb-4">
            <a asp-controller="Services" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Service
            </a>
        </div>
    }

    <div class="row justify-content-center g-4">

        <!-- ✅ Static Service Cards -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Book Lending</h5>
                    <p class="card-text">Borrow a wide variety of books across genres with flexible lending periods.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">E-Resources</h5>
                    <p class="card-text">Access thousands of e-books, journals, and digital archives anytime, anywhere.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Study Spaces</h5>
                    <p class="card-text">Quiet study zones and group discussion rooms designed for focused learning.</p>
                </div>
            </div>
        </div>

        <!-- ✅ Dynamic Service Cards (from DB) -->
        @foreach (var service in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">@service.ServiceName</h5>
                        <p class="card-text">@service.Description</p>

                        <!-- Edit/Delete Buttons (Staff Only) -->
                        @if (Context.Session.GetString("Role") == "Staff")
                        {
                            <div class="mt-3 d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@service.Id" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: #f9f9f9;
    }
    .card {
        border-radius: 15px;
        transition: transform 0.2s ease-in-out;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .btn-primary {
        border-radius: 25px;
        padding: 8px 18px;
    }
</style>
