@{
    ViewData["Title"] = "About Us - Digital Library";
}

<section class="text-center py-5" style="background: linear-gradient(90deg, #6a85b6, #bac8e0); color: #222;">
    <div class="container">
        <h2 class="fw-bold"><span class="fs-3">📚</span> Discover Our Journey</h2>
        <p class="lead mt-3">Serving readers with passion, books, and knowledge since 1990.</p>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center">
        <div class="col-md-6 mb-4 mb-md-0">
            <img src="~/images/library.jpg" alt="Library Management System" class="img-fluid rounded shadow">
        </div>
        <div class="col-md-6 text-start">
            <h4 class="text-primary fw-bold">Who We Are?</h4>
            <p>Founded in 1990, our library has been serving readers for over <strong>30 years</strong> with a strong commitment to knowledge and community.</p>

            <h4 class="text-primary fw-bold mt-4">Our Mission</h4>
            <p>To provide <em>knowledge, resources</em>, and a community space for lifelong learning and creativity.</p>
        </div>
    </div>
</section>

