@model NewFolder.Models.Message

@{
    ViewData["Title"] = "Contact Us";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 600px; border-radius: 1rem;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold text-primary">📩 Contact Us</h2>

            @if(ViewBag.Success != null)
            {
                <div class="alert alert-success text-center fw-semibold">
                    @ViewBag.Success
                </div>
            }

            <form asp-action="Index" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label asp-for="SenderName" class="form-label fw-semibold">Name</label>
                    <input asp-for="SenderName" class="form-control form-control-lg" placeholder="Your Full Name" required />
                    <span asp-validation-for="SenderName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="Your Email Address" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold">Message</label>
                    <textarea asp-for="Content" class="form-control form-control-lg" rows="5" placeholder="Write your message here..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold">Send Message</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
