@model NewFolder.Models.Member

@{
    ViewData["Title"] = "Create Member";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 600px; border-radius: 1rem;">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 fw-bold text-success"> Create Member</h2>

            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Name</label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter full name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="example@email.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Phone Number -->
                <div class="mb-3">
                    <label asp-for="PhoneNo" class="form-label fw-semibold">Phone Number</label>
                    <input asp-for="PhoneNo" class="form-control form-control-lg" placeholder="+91 9876543210" required />
                    <span asp-validation-for="PhoneNo" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Address</label>
                    <input asp-for="Address" class="form-control form-control-lg" placeholder="Enter address" required />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <!-- Membership Date -->
                <div class="mb-3">
                    <label asp-for="MembershipDate" class="form-label fw-semibold">Membership Date</label>
                    <input asp-for="MembershipDate" class="form-control form-control-lg" type="date" required />
                    <span asp-validation-for="MembershipDate" class="text-danger"></span>
                </div>

                <!-- Membership Type -->
                <div class="mb-3">
                    <label asp-for="MembershipType" class="form-label fw-semibold">Membership Type</label>
                    <select asp-for="MembershipType" class="form-select form-select-lg" required>
                        <option value="">--Select--</option>
                        <option>Free</option>
                        <option>Paid</option>
                    </select>
                    <span asp-validation-for="MembershipType" class="text-danger"></span>
                </div>

                <!-- Duration in Months -->
                <div class="mb-3">
                    <label asp-for="DurationInMonths" class="form-label fw-semibold">Duration (Months)</label>
                    <input asp-for="DurationInMonths" class="form-control form-control-lg" type="number" placeholder="e.g. 12" required />
                    <span asp-validation-for="DurationInMonths" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="Enter password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Role -->
                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold">Role</label>
                    <select asp-for="Role" class="form-select form-select-lg" required>
                        <option value="">--Select Role--</option>
                        <option>Member</option>
                        <option>Staff</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-success btn-lg fw-bold">Create Member</button>
                </div>
                <div class="d-grid mt-2">
                    <a asp-action="Index" class="btn btn-secondary btn-lg fw-semibold">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
